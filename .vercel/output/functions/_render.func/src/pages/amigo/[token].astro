---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { leerRegistro } from '../../lib/almacen';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'private, no-store');
let yo = null;
let amigo = null;
try {
  yo = await leerRegistro(Astro.params.token ?? '');
  amigo = yo ? await leerRegistro(yo.r) : null;
} catch {
  yo = null;
}
if (!yo) Astro.response.status = 404;
const eur = (n: number) => new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 2 }).format(n);
const fecha = (d: string) => new Intl.DateTimeFormat('es-ES', { dateStyle: 'full', timeZone: 'UTC' }).format(new Date(`${d}T00:00:00Z`));
---

<Layout title="Tu amigo invisible | Amigo Invisible" description="Tu página privada del amigo invisible." noindex privado>
  <section class="section">
    <div class="container narrow">
      {!yo ? (
        <div class="center">
          <Icon name="lucide:snowflake" class="big-icon" aria-hidden="true" />
          <h1 style="font-size:clamp(1.8rem,4vw,2.6rem)">Este enlace ya no está activo</h1>
          <p class="lead">Los datos del sorteo se borran solos unos días después del intercambio. Si todavía lo necesitas, pide a quien lo organizó que repita el sorteo.</p>
          <p><a class="btn btn-primary btn-lg" href="/crear">Crear un sorteo nuevo</a></p>
        </div>
      ) : (
        <>
          <div class="center">
            <span class="eyebrow">{yo.g}</span>
            <h1 style="font-size:clamp(1.8rem,4vw,2.6rem)">Hola, {yo.n}</h1>
          </div>

          <div class="card" style="margin:1.5rem 0">
            <p class="label" style="margin-bottom:.2rem">Te toca regalar a</p>
            <p style="font-family:var(--font-display);font-size:2rem;font-weight:800;color:var(--red);margin:0 0 .6rem">{amigo?.n ?? '…'}</p>
            <p style="margin:0"><strong>Sus ideas:</strong> {amigo?.w ? amigo.w : 'todavía no ha añadido ideas. Vuelve a mirar más adelante.'}</p>
            {yo.b && <p style="margin:.6rem 0 0"><strong>Presupuesto:</strong> {eur(yo.b)}</p>}
            {yo.d && <p style="margin:.3rem 0 0"><strong>Intercambio:</strong> {fecha(yo.d)}</p>}
          </div>

          <div class="card">
            <h2 style="font-size:1.4rem">Tu lista de deseos</h2>
            <p class="hint">Escribe ideas para que tu amigo invisible acierte. Puedes cambiarla cuando quieras y la verá siempre actualizada.</p>
            <form id="lista-form" novalidate>
              <div class="field">
                <label for="wishlist">Mis ideas de regalo</label>
                <textarea id="wishlist" name="wishlist" rows="3" maxlength="200" placeholder="Ej: libros de misterio, café, calcetines">{yo.w}</textarea>
                <small class="hint" style="margin:0"><span id="contador">{yo.w.length}</span>/200</small>
              </div>
              <button type="submit" class="btn btn-primary" id="guardar">
                <Icon name="lucide:save" aria-hidden="true" /> Guardar mi lista
              </button>
              <p id="estado" role="status" class="hint" style="margin:.8rem 0 0"></p>
            </form>
          </div>
          <p class="hint center" style="margin-top:1.2rem">Es tu enlace privado: no lo compartas. Se borra solo unos días después del intercambio.</p>
        </>
      )}
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('lista-form') as HTMLFormElement | null;
  if (form) {
    const area = document.getElementById('wishlist') as HTMLTextAreaElement;
    const contador = document.getElementById('contador')!;
    const estado = document.getElementById('estado')!;
    const boton = document.getElementById('guardar') as HTMLButtonElement;
    const token = location.pathname.split('/').pop() ?? '';
    area.addEventListener('input', () => { contador.textContent = String(area.value.length); estado.textContent = ''; });
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      boton.disabled = true;
      estado.textContent = 'Guardando…';
      try {
        const res = await fetch('/api/lista', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token, wishlist: area.value }) });
        const data = (await res.json().catch(() => ({}))) as { mensaje?: string };
        estado.textContent = res.ok ? '✔ Guardado. Tu amigo invisible ya verá la versión nueva.' : data.mensaje || 'No se ha podido guardar.';
      } catch {
        estado.textContent = 'No se ha podido guardar. Comprueba la conexión.';
      } finally {
        boton.disabled = false;
      }
    });
  }
</script>
