# URL pública (canonical, sitemap, Open Graph)
SITE_URL=https://tudominio.com

# Envío de correo: Resend (recomendado). Si no está, se usa Gmail; si tampoco, modo simulado.
RESEND_API_KEY=
# Remitente sin buzón detrás: los correos no admiten respuesta. No crees un alias ni un catch-all para esta dirección.
MAIL_FROM="Amigo Invisible <no-reply@tudominio.com>"

# Alternativa: Gmail con contraseña de aplicación (límite ~500 correos/día)
GMAIL_USER=
GMAIL_PASS=

# Cloudflare Turnstile (antibots gratuito e invisible): dash.cloudflare.com → Turnstile → Add widget.
# Con envío real de correos (Resend o Gmail), TURNSTILE_SECRET es obligatorio: sin él no se crean sorteos.
PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
# Claves de prueba oficiales de Cloudflare (siempre aprueban), solo para desarrollo:
#   sitekey 1x00000000000000000000AA   secret 1x0000000000000000000000000000000AA

# Dominio permitido para las peticiones a la API (ej: tudominio.com)
ALLOWED_ORIGIN=

# Enlace de donación (PayPal.me, Ko-fi, Buy Me a Coffee...). Si está vacío, no se muestra.
PUBLIC_DONATE_URL=

# Solo desarrollo: no envía correos de verdad
DEV_BYPASS_EMAILS=false

# Almacén de listas de deseos (Upstash Redis desde el Marketplace de Vercel; también vale KV_REST_API_URL / KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Afiliación (opcional; sin estas variables no aparece ningún enlace de afiliado)
# Etiqueta de Amazon Afiliados España, p. ej. miweb-21
PUBLIC_AMAZON_TAG=
# Enlace de afiliado a excursiones/alojamiento en Rovaniemi (Civitatis, GetYourGuide, Booking...)
PUBLIC_VIAJES_URL=

# Protección contra abuso y métricas (todo opcional; los límites tienen valor por defecto)
# Tope de correos al día en toda la web. El plan gratuito de Resend admite 100 al día: deja margen.
LIMITE_CORREOS_DIA=80
# Máximo de correos al día a una misma dirección (se cuenta con una huella cifrada, no con la dirección)
LIMITE_POR_DESTINATARIO=15
# Máximo de sorteos al día desde una misma IP
LIMITE_SORTEOS_IP_DIA=15
# Token para entrar en /estadisticas (una cadena larga y aleatoria). Sin él, el panel está desactivado.
ADMIN_TOKEN=
# Avisos por Telegram: token del bot (@BotFather) e ID del chat al que escribir
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
