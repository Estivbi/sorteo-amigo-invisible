---
import '../styles/global.css';
import { Icon } from 'astro-icon/components';
import { landings } from '../data/landings';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica empezando por "/" (por defecto, la actual). */
  path?: string;
  noindex?: boolean;
  /** Objetos JSON-LD adicionales. */
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
  /** Página con enlace privado: no indexar y no filtrar el referrer. */
  privado?: boolean;
}

const SITE_NAME = 'Amigo Invisible';
const {
  title,
  description,
  path = Astro.url.pathname,
  noindex = false,
  jsonLd = [],
  ogImage = '/og.png',
  privado = false,
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const sinIndexar = noindex || privado;
const canonical = new URL(path === '/' ? '/' : path.replace(/\/$/, ''), site).toString();
const ogImageUrl = new URL(ogImage, site).toString();
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const donateUrl = import.meta.env.PUBLIC_DONATE_URL || '';

const base = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: new URL('/', site).toString(),
    inLanguage: 'es-ES',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: new URL('/', site).toString(),
    logo: new URL('/favicon.svg', site).toString(),
  },
];
const graph = [...base, ...jsonLd];
const links = [
  { href: '/ideas-regalo', label: 'Ideas de regalo' },
  { href: '/reglas', label: 'Reglas' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={sinIndexar ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    {privado && <meta name="referrer" content="no-referrer" />}
    <meta name="theme-color" content="#b3262e" />
    <meta name="generator" content={Astro.generator} />
    <meta name="recaptcha-sitekey" content={import.meta.env.RECAPTCHA_SITEKEY || ''} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Amigo Invisible: sorteo online gratis para Navidad" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,800&family=Nunito:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    {graph.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/" aria-label="Amigo Invisible, inicio">
          <svg viewBox="0 0 64 64" aria-hidden="true">
            <rect x="8" y="26" width="48" height="30" rx="5" fill="#b3262e"></rect>
            <rect x="5" y="19" width="54" height="11" rx="4" fill="#8c1c23"></rect>
            <rect x="28" y="19" width="8" height="37" fill="#e9b44c"></rect>
            <path d="M32 19c-9-12-20-4-12 0zM32 19c9-12 20-4 12 0z" fill="none" stroke="#e9b44c" stroke-width="4" stroke-linejoin="round"></path>
          </svg>
          Amigo Invisible
        </a>
        <nav class="nav" aria-label="Principal">
          {links.map((l) => <a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a>)}
          <a class="btn btn-primary btn-sm" href="/crear">Crear sorteo</a>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h2>Amigo Invisible</h2>
            <p>El sorteo de amigo invisible online más sencillo: gratis, sin registro y sin guardar tus correos.</p>
          </div>
          <div>
            <h2>Sorteos para cada ocasión</h2>
            <ul>
              {landings.map((l) => <li><a href={`/amigo-invisible/${l.slug}`}>{l.nav}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>Más</h2>
            <ul>
              <li><a href="/crear">Crear sorteo</a></li>
              <li><a href="/ideas-regalo">Ideas de regalo</a></li>
              <li><a href="/reglas">Reglas y consejos</a></li>
              <li><a href="/privacidad">Privacidad</a></li>
              {donateUrl && <li><a href={donateUrl} rel="noopener" target="_blank"><Icon name="lucide:coffee" aria-hidden="true" /> Invítanos a un café</a></li>}
            </ul>
          </div>
        </div>
        <p class="copy">&copy; {new Date().getFullYear()} Amigo Invisible. Hecho con cariño para que la Navidad se parezca más a una fiesta.</p>
      </div>
    </footer>
      <script>
      import '../scripts/nieve';
    </script>
  </body>
</html>
