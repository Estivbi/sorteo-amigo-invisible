---
import '../styles/global.css';
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/nunito/wght.css';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import nunitoLatin from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';
import { Icon } from 'astro-icon/components';
import { landings } from '../data/landings';
import { AVISO_AMAZON } from '../lib/afiliados';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica empezando por "/" (por defecto, la actual). */
  path?: string;
  noindex?: boolean;
  /** Objetos JSON-LD adicionales. */
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
  /** Página con enlace privado: no indexar y no filtrar el referrer. */
  privado?: boolean;
}

const SITE_NAME = 'Amigo Invisible';
const {
  title,
  description,
  path = Astro.url.pathname,
  noindex = false,
  jsonLd = [],
  ogImage = '/og.png',
  privado = false,
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const sinIndexar = noindex || privado;
const canonical = new URL(path === '/' ? '/' : path.replace(/\/$/, ''), site).toString();
const ogImageUrl = new URL(ogImage, site).toString();
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const donateUrl = import.meta.env.PUBLIC_DONATE_URL || '';
const hayAfiliados = Boolean(import.meta.env.PUBLIC_AMAZON_TAG);

const base = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: new URL('/', site).toString(),
    inLanguage: 'es-ES',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: new URL('/', site).toString(),
    logo: new URL('/favicon.svg', site).toString(),
  },
];
const graph = [...base, ...jsonLd];
const links = [
  { href: '/ideas-regalo', label: 'Ideas de regalo' },
  { href: '/reglas', label: 'Reglas' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={sinIndexar ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    {privado && <meta name="referrer" content="no-referrer" />}
    <meta name="theme-color" content="#b3262e" />
    <meta name="generator" content={Astro.generator} />
    <meta name="turnstile-sitekey" content={import.meta.env.PUBLIC_TURNSTILE_SITEKEY || ''} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Amigo Invisible: sorteo online gratis para Navidad" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preload" href={nunitoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />

    {graph.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:rounded-lg focus:bg-neutral focus:px-4 focus:py-2 focus:text-neutral-content" href="#contenido">Saltar al contenido</a>
    <header class="sticky top-0 z-30 border-b border-base-300 bg-base-100">
      <div class="navbar mx-auto min-h-16 max-w-5xl px-4">
        <div class="navbar-start">
          <a class="flex items-center gap-2 py-2 font-display text-xl font-extrabold text-rojo-oscuro no-underline hover:text-primary sm:text-2xl" href="/" aria-label="Amigo Invisible, inicio">
            <svg viewBox="0 0 64 64" class="size-8 shrink-0" aria-hidden="true">
              <rect x="8" y="26" width="48" height="30" rx="5" fill="#b3262e"></rect>
              <rect x="5" y="19" width="54" height="11" rx="4" fill="#8c1c23"></rect>
              <rect x="28" y="19" width="8" height="37" fill="#e9b44c"></rect>
              <path d="M32 19c-9-12-20-4-12 0zM32 19c9-12 20-4 12 0z" fill="none" stroke="#e9b44c" stroke-width="4" stroke-linejoin="round"></path>
            </svg>
            <span class="whitespace-nowrap max-xs:hidden">Amigo Invisible</span>
          </a>
        </div>
        <div class="navbar-end gap-1">
          <nav class="hidden items-center gap-1 md:flex" aria-label="Principal">
            {links.map((l) => <a class:list={['btn btn-ghost font-bold', current === l.href && 'text-primary underline decoration-2 underline-offset-8']} href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a>)}
          </nav>
          <a class="btn btn-primary" href="/crear">Crear sorteo</a>
          <details class="dropdown dropdown-end md:hidden" id="menu-movil">
            <summary class="btn btn-ghost btn-square" aria-label="Menú">
              <span class="relative block size-6" aria-hidden="true">
                <Icon name="lucide:menu" class="icono-menu absolute inset-0 !size-6" />
                <Icon name="lucide:x" class="icono-x absolute inset-0 !size-6" />
              </span>
            </summary>
            <ul class="menu menu-panel dropdown-content z-40 mt-3 w-64 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg">
              {links.map((l) => <li><a class="py-3 font-bold" href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a></li>)}
              <li class="menu-title mt-2">Sorteos para cada ocasión</li>
              {landings.map((l) => <li><a class="py-3" href={`/amigo-invisible/${l.slug}`}><Icon name={l.icon} aria-hidden="true" /> {l.nav}</a></li>)}
            </ul>
          </details>
        </div>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="mt-8 bg-rojo-profundo text-neutral-content">
      <div class="footer mx-auto max-w-5xl gap-8 px-4 py-10 sm:footer-horizontal">
        <aside class="max-w-xs">
          <p class="font-display text-xl font-bold text-white">Amigo Invisible</p>
          <p>El sorteo de amigo invisible online más sencillo: gratis, sin registro y sin guardar tus correos.</p>
        </aside>
        <nav aria-label="Sorteos para cada ocasión">
          <h2 class="footer-title text-accent normal-case tracking-normal opacity-100">Sorteos para cada ocasión</h2>
          {landings.map((l) => <a class="link link-hover" href={`/amigo-invisible/${l.slug}`}>{l.nav}</a>)}
        </nav>
        <nav aria-label="Más enlaces">
          <h2 class="footer-title text-accent normal-case tracking-normal opacity-100">Más</h2>
          <a class="link link-hover" href="/crear">Crear sorteo</a>
          <a class="link link-hover" href="/ideas-regalo">Ideas de regalo</a>
          <a class="link link-hover" href="/reglas">Reglas y consejos</a>
          <a class="link link-hover" href="/privacidad">Privacidad</a>
          {donateUrl && <a class="link link-hover" href={donateUrl} rel="noopener" target="_blank"><Icon name="lucide:coffee" aria-hidden="true" /> Invítanos a un café</a>}
        </nav>
      </div>
      <div class="mx-auto max-w-5xl border-t border-white/20 px-4 py-4 text-sm">
        {hayAfiliados && <p class="mb-2">{AVISO_AMAZON}</p>}
        <p>&copy; {new Date().getFullYear()} Amigo Invisible. Hecho con cariño para que la Navidad se parezca más a una fiesta.</p>
      </div>
    </footer>
    <script>
      import '../scripts/nieve';
      import '../scripts/menu';
    </script>
  </body>
</html>
