---
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const pasos = [
  { t: 'Preparación digital', d: 'Añade a todos los participantes con su correo. Se acabaron los papelitos y el gorro.' },
  { t: 'Sorteo inteligente', d: 'El sistema asigna a cada persona un amigo invisible, sin repetirse a sí misma y respetando las excepciones que configures.' },
  { t: 'Notificación secreta', d: 'Cada participante recibe un email privado con el nombre de la persona a quien debe regalar.' },
  { t: 'A regalar', d: 'Cada uno compra su regalo dentro del presupuesto y guarda el secreto hasta el día del intercambio.' },
];
const consejos = [
  { t: 'Presupuesto justo', d: 'Fija un rango cómodo para todos (por ejemplo, 15-25 €).' },
  { t: 'Excepciones útiles', d: 'Úsalas para parejas, familiares directos o quien ya se regaló el año anterior.' },
  { t: 'Mantén el secreto', d: 'La gracia es la sorpresa: no reveles a quién te tocó hasta el intercambio.' },
  { t: 'Fecha límite', d: 'Acuerda un día concreto para el intercambio y recuérdalo al grupo.' },
  { t: 'Lista de deseos', d: 'Cada persona puede añadir 2 o 3 ideas y cambiarlas cuando quiera desde su correo. Es la mejor manera de acertar.' },
];
---

<Layout
  title="Reglas del amigo invisible: cómo funciona y consejos"
  description="Aprende cómo funciona el amigo invisible y descubre consejos para organizar un sorteo justo: presupuesto, excepciones, lista de deseos y fecha de intercambio."
  path="/reglas"
>
  <section class="hero">
    <div class="container narrow">
      <h1>Reglas del amigo invisible</h1>
      <p class="lead">Todo lo que necesitas para organizar un sorteo perfecto.</p>
    </div>
  </section>
  <section class="section">
    <div class="container narrow">
      <h2>Cómo funciona</h2>
      <div class="grid">
        {pasos.map((p, i) => <div class="card"><span class="step-num">{i + 1}</span><h3>{p.t}</h3><p>{p.d}</p></div>)}
      </div>
      <h2 style="margin-top:2.5rem">Consejos pro</h2>
      <div class="grid grid-2">
        {consejos.map((c) => <div class="card"><h3>{c.t}</h3><p>{c.d}</p></div>)}
      </div>
      <p class="center" style="margin-top:2.5rem"><a class="btn btn-primary btn-lg" href="/crear">Crear mi sorteo ahora</a></p>
    </div>
  </section>
</Layout>
