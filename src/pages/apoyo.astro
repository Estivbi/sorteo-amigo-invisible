---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Apoya el Proyecto - Amigo Invisible">
  <div class="container">
    <!-- Hero Section -->
    <div style="text-align: center; margin: 3rem 0;">
      <h1 style="font-size: 3rem; margin-bottom: 1rem; font-weight: 800;">
        ☕ Apoya el Proyecto
      </h1>
      <p style="font-size: 1.25rem; color: rgba(255,255,255,0.9); margin-bottom: 2rem; max-width: 700px; margin-left: auto; margin-right: auto; line-height: 1.6;">
        <strong>¡Gracias por usar Amigo Invisible!</strong> Esta web es completamente gratuita, 
        pero mantenerla funcional requiere tiempo y recursos.
      </p>
    </div>

    <!-- Main Content -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 3rem; margin: 4rem 0;">
      
      <!-- Información del proyecto -->
      <div class="card" style="padding: 2.5rem;">
        <h2 style="font-size: 1.8rem; font-weight: 700; margin-bottom: 1.5rem; color: #4a5568; text-align: center;">
          💡 ¿Por qué donar?
        </h2>
        <div style="space-y: 1rem;">
          <div style="display: flex; align-items: flex-start; gap: 12px; margin-bottom: 1rem;">
            <span style="font-size: 1.5rem;">🌐</span>
            <div>
              <h3 style="font-weight: 600; color: #4a5568; margin: 0 0 0.5rem 0;">Hosting y Dominio</h3>
              <p style="color: #6b7280; margin: 0; line-height: 1.5;">Mantener la web online las 24h cuesta dinero</p>
            </div>
          </div>
          
          <div style="display: flex; align-items: flex-start; gap: 12px; margin-bottom: 1rem;">
            <span style="font-size: 1.5rem;">⚡</span>
            <div>
              <h3 style="font-weight: 600; color: #4a5568; margin: 0 0 0.5rem 0;">Nuevas Funcionalidades</h3>
              <p style="color: #6b7280; margin: 0; line-height: 1.5;">Tiempo de desarrollo para mejoras y características</p>
            </div>
          </div>
          
          <div style="display: flex; align-items: flex-start; gap: 12px; margin-bottom: 1rem;">
            <span style="font-size: 1.5rem;">📧</span>
            <div>
              <h3 style="font-weight: 600; color: #4a5568; margin: 0 0 0.5rem 0;">Servicio de Email</h3>
              <p style="color: #6b7280; margin: 0; line-height: 1.5;">Envío gratuito de miles de correos cada mes</p>
            </div>
          </div>
          
          <div style="display: flex; align-items: flex-start; gap: 12px;">
            <span style="font-size: 1.5rem;">🔧</span>
            <div>
              <h3 style="font-weight: 600; color: #4a5568; margin: 0 0 0.5rem 0;">Mantenimiento</h3>
              <p style="color: #6b7280; margin: 0; line-height: 1.5;">Soporte técnico y corrección de errores</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Opciones de donación -->
      <div class="card" style="padding: 2.5rem;">
        <h2 style="font-size: 1.8rem; font-weight: 700; margin-bottom: 1.5rem; color: #4a5568; text-align: center;">
          💖 Opciones de Donación
        </h2>
        
        <div style="margin-bottom: 2rem;">
          <p style="color: #6b7280; text-align: center; line-height: 1.6; margin-bottom: 2rem;">
            Cualquier cantidad es súper apreciada. ¡Incluso €1 ayuda muchísimo!
          </p>
        </div>

        <!-- Botones de donación PayPal -->
        <div style="display: grid; gap: 1rem;">
          <!-- Opción simple: Un solo botón para donaciones -->
          <div style="text-align: center; margin-bottom: 2rem;">
            <p style="color: #6b7280; margin-bottom: 1rem;">Haz clic para donar la cantidad que prefieras:</p>
            <form action="https://www.paypal.com/donate" method="post" target="_top" style="margin: 0; padding: 0; background: none; box-shadow: none; border: none;">
              <!-- Reemplaza TU_EMAIL_PAYPAL por tu email de PayPal -->
              <input type="hidden" name="business" value="TU_EMAIL_PAYPAL@gmail.com" />
              <input type="hidden" name="currency_code" value="EUR" />
              <button type="submit" style="width: 100%; background: linear-gradient(45deg, #667eea, #764ba2); color: white; border: none; border-radius: 12px; padding: 20px; font-weight: 600; font-size: 18px; cursor: pointer; transition: all 0.3s ease; display: flex; align-items: center; justify-content: center; gap: 10px;">
                💖 Donar con PayPal
              </button>
            </form>
          </div>

          <!-- Botones sugeridos (opcionales) -->
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.8rem;">
            <a href="https://www.paypal.com/donate/?business=TU_EMAIL_PAYPAL@gmail.com&amount=1&currency_code=EUR" target="_blank" style="text-decoration: none;">
              <button type="button" style="width: 100%; background: linear-gradient(45deg, #ffb347, #ff6b35); color: white; border: none; border-radius: 8px; padding: 12px; font-weight: 600; font-size: 14px; cursor: pointer; transition: all 0.3s ease;">
                ☕ €1
              </button>
            </a>
            <a href="https://www.paypal.com/donate/?business=TU_EMAIL_PAYPAL@gmail.com&amount=3&currency_code=EUR" target="_blank" style="text-decoration: none;">
              <button type="button" style="width: 100%; background: linear-gradient(45deg, #48bb78, #38a169); color: white; border: none; border-radius: 8px; padding: 12px; font-weight: 600; font-size: 14px; cursor: pointer; transition: all 0.3s ease;">
                🥪 €3
              </button>
            </a>
            <a href="https://www.paypal.com/donate/?business=TU_EMAIL_PAYPAL@gmail.com&amount=5&currency_code=EUR" target="_blank" style="text-decoration: none;">
              <button type="button" style="width: 100%; background: linear-gradient(45deg, #667eea, #764ba2); color: white; border: none; border-radius: 8px; padding: 12px; font-weight: 600; font-size: 14px; cursor: pointer; transition: all 0.3s ease;">
                🍕 €5
              </button>
            </a>
          </div>
        </div>

        <div style="margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #e2e8f0; text-align: center;">
          <p style="color: #6b7280; font-size: 0.9rem; line-height: 1.5; margin: 0;">
            🔒 <strong>Pago 100% seguro</strong> a través de PayPal<br>
            No es necesario tener cuenta PayPal
          </p>
        </div>
      </div>
    </div>

    <!-- Estadísticas y transparencia -->
    <div class="card" style="margin: 3rem auto; max-width: 800px; padding: 2.5rem; text-align: center;">
      <h2 style="font-size: 1.8rem; font-weight: 700; margin-bottom: 1.5rem; color: #4a5568;">
        📊 Transparencia Total
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; margin-top: 2rem;">
        <div>
          <div style="font-size: 2rem; margin-bottom: 0.5rem;">🎁</div>
          <h3 style="font-size: 1.2rem; font-weight: 600; color: #4a5568; margin: 0 0 0.5rem 0;">Sorteos Creados</h3>
          <p style="color: #6b7280; font-size: 1.5rem; font-weight: 700; margin: 0;">+1,000</p>
        </div>
        <div>
          <div style="font-size: 2rem; margin-bottom: 0.5rem;">📧</div>
          <h3 style="font-size: 1.2rem; font-weight: 600; color: #4a5568; margin: 0 0 0.5rem 0;">Emails Enviados</h3>
          <p style="color: #6b7280; font-size: 1.5rem; font-weight: 700; margin: 0;">+10,000</p>
        </div>
        <div>
          <div style="font-size: 2rem; margin-bottom: 0.5rem;">💰</div>
          <h3 style="font-size: 1.2rem; font-weight: 600; color: #4a5568; margin: 0 0 0.5rem 0;">Costo Mensual</h3>
          <p style="color: #6b7280; font-size: 1.5rem; font-weight: 700; margin: 0;">~€15</p>
        </div>
      </div>
    </div>

    <!-- Mensaje de agradecimiento -->
    <div style="text-align: center; margin: 3rem 0;">
      <div style="background: rgba(255, 255, 255, 0.1); border-radius: 20px; padding: 2rem; border: 1px solid rgba(255, 255, 255, 0.2);">
        <h2 style="font-size: 1.5rem; font-weight: 600; color: rgba(255,255,255,0.9); margin-bottom: 1rem;">
          🙏 ¡Muchísimas Gracias!
        </h2>
        <p style="color: rgba(255,255,255,0.8); line-height: 1.6; margin: 0; max-width: 600px; margin: 0 auto;">
          Cada donación, por pequeña que sea, me motiva a seguir mejorando esta web 
          y mantenerla gratuita para todos. ¡Eres increíble! ❤️
        </p>
      </div>
    </div>

    <!-- Volver al inicio -->
    <div style="text-align: center; margin: 2rem 0;">
      <a href="/" style="text-decoration: none;">
        <button class="btn-primary" style="width: auto; display: inline-block;">
          🏠 Volver al Inicio
        </button>
      </a>
    </div>
  </div>
</Layout>

<style>
  /* Hover effects para botones de donación */
  form button:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  }
</style>
