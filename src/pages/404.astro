---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout title="Página no encontrada | Amigo Invisible" description="La página que buscas no existe." noindex>
  <section class="section">
    <div class="container narrow center">
      <p style="font-size:4rem;margin:0">🎄</p>
      <h1>Esta página se ha hecho la invisible</h1>
      <p class="lead">No encontramos lo que buscas, pero tu sorteo sí puede empezar ahora.</p>
      <p><a class="btn btn-primary btn-lg" href="/crear">Crear sorteo gratis</a></p>
    </div>
  </section>
</Layout>
