---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AvisoAfiliados from '../components/AvisoAfiliados.astro';
import { enlaceAmazon, REL_AFILIADO } from '../lib/afiliados';
import { Icon } from 'astro-icon/components';
import { rangos } from '../data/ideas';

export const prerender = true;
const tag = import.meta.env.PUBLIC_AMAZON_TAG;

const listLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Ideas de regalo para amigo invisible por precio',
  itemListElement: rangos.flatMap((r, i) => [{ '@type': 'ListItem', position: i + 1, name: r.titulo, url: new URL(`/ideas-regalo#${r.id}`, Astro.site).toString() }]),
};
---

<Layout
  title="Ideas de regalo para amigo invisible: 5, 10, 20 y 30 euros"
  description="Más de 25 ideas de regalo para el amigo invisible organizadas por presupuesto: 5, 10, 20 y 30 euros. Acierta sin gastar de más."
  path="/ideas-regalo"
  jsonLd={[listLd]}
>
  <Hero narrow>
    <h1 class="mb-4 text-4xl text-white sm:text-5xl">Ideas de regalo para amigo invisible</h1>
    <p class="mb-5 text-lg text-[#ffe9d2] sm:text-xl">Regalos que gustan, ordenados por presupuesto. Elige el tope de tu sorteo y acierta sin pasarte.</p>
    <ul class="flex flex-wrap gap-2">
      {rangos.map((r) => <li><a class="btn border-0 bg-white text-primary hover:bg-oro-suave" href={`#${r.id}`}>{r.precio}</a></li>)}
    </ul>
  </Hero>

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-3xl space-y-10 px-4">
      <AvisoAfiliados />
      {rangos.map((r) => (
        <section id={r.id} class="scroll-mt-24">
          <h2 class="mb-4 text-2xl sm:text-3xl">{r.titulo}</h2>
          <ul class="grid gap-2 sm:grid-cols-2">
            {r.ideas.map((i) => {
              const url = enlaceAmazon(i.q, tag);
              return (
                <li class="flex items-center gap-3 rounded-box border border-base-300 bg-base-100 py-1 ps-4 pe-1">
                  <Icon name="lucide:gift" class="size-5 shrink-0 text-primary" aria-hidden="true" />
                  <span class="flex-1 py-2">{i.t}</span>
                  {url && (
                    <a class="btn btn-ghost btn-sm min-h-11 text-primary" href={url} target="_blank" rel={REL_AFILIADO} aria-label={`Buscar ${i.t} en Amazon`}>
                      <Icon name="lucide:search" aria-hidden="true" /> Buscar
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))}
      <div class="card border border-base-300 bg-crema text-center"><div class="card-body items-center">
        <h2 class="text-2xl sm:text-3xl">¿Ya sabes cuánto gastar?</h2>
        <p>Crea el sorteo, indica el presupuesto y cada participante lo verá en su correo, junto con su lista de deseos.</p>
        <a class="btn btn-primary btn-lg w-full sm:w-auto" href="/crear">Crear sorteo gratis</a>
      </div></div>
    </div>
  </section>
</Layout>
