---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

export const prerender = true;
const donateUrl = import.meta.env.PUBLIC_DONATE_URL || '';
---

<Layout
  title="Crear sorteo de amigo invisible gratis | Amigo Invisible"
  description="Crea tu sorteo de amigo invisible online: añade participantes, presupuesto, fecha y excepciones. Cada uno recibe su asignación por email. Gratis y sin registro."
  path="/crear"
>
  <section class="section">
    <div class="container narrow">
      <div class="center">
        <span class="eyebrow">Paso a paso</span>
        <h1 style="font-size:clamp(1.9rem,4.5vw,2.8rem)">Crea tu sorteo</h1>
        <p class="lead">Los correos no se guardan nunca. Solo guardamos nombres y listas de deseos unos días, para que cada uno pueda editar la suya.</p>
      </div>

      <div class="form-card" style="margin-top:1.5rem">
        <form id="create-game-form" novalidate data-donate={donateUrl}>
          <div id="form-error" class="alert alert-error hidden" role="alert" tabindex="-1"></div>

          <fieldset>
            <legend>1. Datos del sorteo</legend>
            <div class="field">
              <label for="gameName">Nombre del sorteo</label>
              <input type="text" id="gameName" name="gameName" maxlength="80" placeholder="Ej: Amigo invisible de la oficina" required />
            </div>
            <div class="row-2">
              <div class="field">
                <label for="budget">Presupuesto en € (opcional)</label>
                <input type="number" id="budget" name="budget" min="0" max="10000" step="1" inputmode="decimal" placeholder="Ej: 20" />
              </div>
              <div class="field">
                <label for="eventDate">Fecha del intercambio (opcional)</label>
                <input type="date" id="eventDate" name="eventDate" />
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>2. Participantes</legend>
            <p class="hint">Mínimo 3 y máximo 40. Cada uno puede indicar ideas de regalo ahora, y podrá cambiarlas después desde su correo.</p>
            <div id="participants-list"></div>
            <button type="button" id="add-participant" class="btn btn-outline">+ Añadir participante</button>
          </fieldset>

          <fieldset>
            <legend>3. Excepciones (opcional)</legend>
            <p class="hint">Útil para parejas, hermanos o quien ya se regaló el año pasado.</p>
            <div id="exceptions-list"></div>
            <button type="button" id="add-exception" class="btn btn-ghost">+ Añadir excepción</button>
          </fieldset>

          <div class="honeypot" aria-hidden="true">
            <label for="website">No rellenar</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <button type="submit" id="submit-btn" class="btn btn-primary btn-lg" style="width:100%">
            <span class="spinner hidden" aria-hidden="true"></span>
            <span id="submit-label">Sortear y enviar correos</span>
          </button>
          <p class="hint center" style="margin:0.9rem 0 0">Protegido por reCAPTCHA de Google.</p>
        </form>

        <div id="success" class="success hidden" tabindex="-1" role="status">
          <div class="big" aria-hidden="true"><Icon name="lucide:party-popper" aria-hidden="true" style="width:4rem;height:4rem;color:var(--red)" /></div>
          <h2>¡Sorteo hecho!</h2>
          <p id="success-msg">Hemos enviado a cada participante su amigo invisible. Si alguien no lo ve, que revise el spam.</p>
          <div class="share-row">
            <a id="share-wa" class="btn btn-primary" target="_blank" rel="noopener">Avisar al grupo por WhatsApp</a>
            <a class="btn btn-outline" href="/crear">Hacer otro sorteo</a>
          </div>
          {donateUrl && (
            <div class="donate">
              <h3><Icon name="lucide:coffee" aria-hidden="true" /> ¿Te ha sido útil?</h3>
              <p>Mantener esta web gratis cuesta tiempo y dinero. Un café ayuda mucho.</p>
              <a class="btn btn-gold" href={donateUrl} target="_blank" rel="noopener">Invitar a un café</a>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { iniciarFormulario } from '../scripts/crear';
  iniciarFormulario();
</script>
