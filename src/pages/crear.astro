---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

export const prerender = true;
const donateUrl = import.meta.env.PUBLIC_DONATE_URL || '';
---

<Layout
  title="Crear sorteo de amigo invisible gratis | Amigo Invisible"
  description="Crea tu sorteo de amigo invisible online: añade participantes, presupuesto, fecha y excepciones. Cada uno recibe su asignación por email. Gratis y sin registro."
  path="/crear"
>
  <section class="py-10 sm:py-14">
    <div class="mx-auto max-w-3xl px-4">
      <div class="mb-6 text-center">
        <h1 class="mb-3 text-3xl sm:text-5xl">Crea tu sorteo</h1>
        <p class="mx-auto max-w-xl text-lg text-tinta-suave">Los correos no se guardan nunca. Solo guardamos nombres y listas de deseos unos días, para que cada uno pueda editar la suya.</p>
      </div>

      <div class="card border border-base-300 bg-base-100 shadow-lg">
        <div class="card-body p-4 sm:p-8">
          <form id="create-game-form" novalidate class="space-y-8">
            <div id="form-error" class="alert alert-error alert-soft" role="alert" tabindex="-1" hidden></div>

            <fieldset class="space-y-4">
              <legend class="mb-1 font-display text-2xl font-bold">1. Datos del sorteo</legend>
              <div class="flex flex-col gap-1">
                <label class="font-bold" for="gameName">Nombre del sorteo</label>
                <input class="input w-full" type="text" id="gameName" name="gameName" maxlength="80" placeholder="Ej: Amigo invisible de la oficina" required />
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="flex flex-col gap-1">
                  <label class="font-bold" for="budget">Presupuesto en € (opcional)</label>
                  <input class="input w-full" type="number" id="budget" name="budget" min="0" max="10000" step="1" inputmode="decimal" placeholder="Ej: 20" />
                </div>
                <div class="flex flex-col gap-1">
                  <label class="font-bold" for="eventDate">Fecha del intercambio (opcional)</label>
                  <input class="input w-full" type="date" id="eventDate" name="eventDate" />
                </div>
              </div>
            </fieldset>

            <fieldset>
              <legend class="mb-1 font-display text-2xl font-bold">2. Participantes</legend>
              <p class="mb-4 text-tinta-suave">Mínimo 3 y máximo 40. Cada uno puede indicar ideas de regalo ahora, y podrá cambiarlas después desde su correo.</p>
              <div id="participants-list"></div>
              <button type="button" id="add-participant" class="btn btn-outline btn-primary w-full sm:w-auto"><Icon name="lucide:plus" aria-hidden="true" /> Añadir participante</button>
            </fieldset>

            <fieldset>
              <legend class="mb-1 font-display text-2xl font-bold">3. Excepciones (opcional)</legend>
              <p class="mb-4 text-tinta-suave">Útil para parejas, hermanos o quien ya se regaló el año pasado.</p>
              <div id="exceptions-list"></div>
              <button type="button" id="add-exception" class="btn btn-ghost w-full border-base-300 sm:w-auto"><Icon name="lucide:plus" aria-hidden="true" /> Añadir excepción</button>
            </fieldset>

            <div class="honeypot" aria-hidden="true">
              <label for="website">No rellenar</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <div>
              <button type="submit" id="submit-btn" class="btn btn-primary btn-lg w-full">
                <span class="loading loading-spinner" aria-hidden="true" hidden></span>
                <span id="submit-label">Sortear y enviar correos</span>
              </button>
              <p class="mt-3 text-center text-sm text-tinta-suave">Protegido por reCAPTCHA de Google.</p>
            </div>
          </form>

          <div id="success" class="py-4 text-center" tabindex="-1" role="status" hidden>
            <Icon name="lucide:party-popper" class="mx-auto mb-3 size-16 text-primary" aria-hidden="true" />
            <h2 class="mb-2 text-3xl">¡Sorteo hecho!</h2>
            <p id="success-msg" class="mb-6 text-tinta-suave">Hemos enviado a cada participante su amigo invisible. Si alguien no lo ve, que revise el spam.</p>
            <div class="flex flex-col justify-center gap-3 sm:flex-row">
              <a id="share-wa" class="btn btn-primary" target="_blank" rel="noopener">Avisar al grupo por WhatsApp</a>
              <a class="btn btn-outline btn-primary" href="/crear">Hacer otro sorteo</a>
            </div>
            {donateUrl && (
              <div class="mt-8 rounded-box border border-accent bg-oro-suave p-5">
                <h3 class="mb-1 text-xl"><Icon name="lucide:coffee" aria-hidden="true" /> ¿Te ha sido útil?</h3>
                <p class="mb-3">Mantener esta web gratis cuesta tiempo y dinero. Un café ayuda mucho.</p>
                <a class="btn btn-accent" href={donateUrl} target="_blank" rel="noopener">Invitar a un café</a>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { iniciarFormulario } from '../scripts/crear';
  iniciarFormulario();
</script>
