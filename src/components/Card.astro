---
const props = Astro.props as Record<string, any>
const { as = 'div', class: extraClass, ...rest } = props
const Tag = as
const finalClass = `card ${extraClass ?? (props.class ?? '')}`.trim()
---

{Tag === 'section' ? (
  <section class={finalClass} {...rest}><slot /></section>
) : Tag === 'article' ? (
  <article class={finalClass} {...rest}><slot /></article>
) : (
  <div class={finalClass} {...rest}><slot /></div>
)}
